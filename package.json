{
  "name": "adoce-fidelidade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/verify-primary-workspace.mjs && tsc -b && vite build && node scripts/generate-seo-pages.mjs && node scripts/verify-operation-release.mjs",
    "test": "vitest run",
    "lint": "tsc -b --pretty false",
    "generate:assets": "node scripts/generate-assets.mjs",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "docs:build": "node scripts/generate-docs.mjs",
    "release:check": "node scripts/verify-primary-workspace.mjs && node scripts/release-check.mjs",
    "release:preview": "npm run release:check && npx --yes netlify-cli@26.2.0 deploy --alias=homologacao-adoce --skip-functions-cache",
    "release:prod": "npm run release:check && npx --yes netlify-cli@26.2.0 deploy --prod --skip-functions-cache",
    "prebuild": "node scripts/verify-primary-workspace.mjs && npm run generate:pwa-icons && npm run docs:build",
    "launch:build": "node scripts/generate-launch-page-v3.mjs",
    "launch:verify": "node scripts/verify-launch-v3.cjs",
    "predev": "node scripts/verify-primary-workspace.mjs",
    "pretest": "node scripts/verify-primary-workspace.mjs",
    "prelint": "node scripts/verify-primary-workspace.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "latest",
    "@supabase/supabase-js": "2.110.6",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-icons": "^5.7.0",
    "twilio": "^6.1.0",
    "vite": "latest",
    "web-push": "^3.6.7",
    "@capacitor/core": "^8.5.0",
    "@capacitor/android": "^8.5.0",
    "@zxing/browser": "0.2.1",
    "qrcode": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/web-push": "^3.6.4",
    "supabase": "2.109.1",
    "typescript": "latest",
    "vitest": "latest",
    "@capacitor/cli": "^8.5.0",
    "@types/qrcode": "latest"
  }
}
